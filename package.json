{
  "name": "halloween-peli-ilta",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Halloween-peli-illan selainpeli: seitsemän minipeliä, vuorotellen samalla koneella.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "tarkista-sisalto": "tsx scripts/tarkista-sisalto.ts",
    "kuvalista": "tsx scripts/kuvalista.ts",
    "e2e": "playwright test"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource/grenze-gotisch": "5.3.0",
    "@fontsource/nunito": "5.3.0",
    "@fontsource/patrick-hand": "5.3.0",
    "phaser": "3.90.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
